# Local environment file — fill in real values and DO NOT commit this file.
# Add `.env` to backend/.gitignore if it isn't already there.

PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
